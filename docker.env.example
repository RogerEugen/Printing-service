APP_NAME="Elegansky Print"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://printer.eleganskyfinance.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eleganskyPrinterSystem
DB_USERNAME=printer_app
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SEPARATE_STRONG_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

PRINT_MAX_UPLOAD_KB=20480
PRINT_MAX_COPIES=20
PRINTER_OFFLINE_AFTER_SECONDS=90
DEV_ADMIN_PASSWORD=

APP_HTTP_PORT=18082
APP_IMAGE_TAG=latest
PRINTER_DATA_ROOT=/srv/apps/printer/admin01/data
